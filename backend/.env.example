# Copie para .env e ajuste. Nunca versione o .env.
ENV=dev
DEBUG=false

# Aceita também o formato dos provedores de nuvem (Aiven/Render/Neon):
#   postgres://usuario:senha@host:porta/banco?sslmode=require
DATABASE_URL=postgresql+asyncpg://disciplina:disciplina@127.0.0.1:5432/disciplina
# Conexões por worker (bancos gratuitos limitam: Aiven Free = 20)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Deploy em um container só (Render etc.): a API também serve o PWA compilado desta pasta.
# Vazio = só API (o Vite em dev, ou o Caddy em produção, servem o front).
STATIC_DIR=

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Em dev sem HTTPS o cookie precisa ser não-secure
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT_PER_MINUTE=10
# Cadastro fechado: com um código aqui, só cria conta quem digitar o código na tela de
# criar conta (uso pessoal / poucos usuários). Vazio = qualquer pessoa pode se cadastrar.
SIGNUP_INVITE_CODE=

DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_DISCIPLINE_TARGET=80

# Fechamento do dia (hora local do usuário) e job de finalização
DAY_CLOSE_HOUR=3
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5

# Despertador: minutos sem confirmar até o alarme contar como perdido
ALARM_MISSED_MINUTES=60
# Web Push (VAPID). Gere o par com: python -m app.core.push
# Sem as chaves o app funciona, mas o alarme só toca com o app aberto.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@disciplina.app

# IA para estudos (Fase 12) — qualquer provedor compatível com a API da OpenAI.
# Sem AI_API_KEY o app mostra "IA não configurada" e o resto funciona normalmente.
# Gratuitos para começar: Groq (console.groq.com), Google AI Studio (Gemini), Mistral (console.mistral.ai).
#   Groq:    AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile  AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash  AI_VISION_MODEL=gemini-2.5-flash
#   OpenAI:  AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini  AI_VISION_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_TIMEOUT_SECONDS=90
