# Copie para .env e ajuste. Nunca versione o .env.
ENV=dev
DEBUG=false

DATABASE_URL=postgresql+asyncpg://disciplina:disciplina@127.0.0.1:5432/disciplina

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Em dev sem HTTPS o cookie precisa ser não-secure
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT_PER_MINUTE=10

DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_DISCIPLINE_TARGET=80

# Fechamento do dia (hora local do usuário) e job de finalização
DAY_CLOSE_HOUR=3
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
