# Variáveis do docker-compose (produção). Copie para .env na raiz.
DOMAIN=app.seudominio.com.br

POSTGRES_DB=disciplina
POSTGRES_USER=disciplina
POSTGRES_PASSWORD=troque-esta-senha

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres

WEB_CONCURRENCY=2

# Cadastro fechado (opcional): só cria conta quem digitar este código. Vazio = aberto.
SIGNUP_INVITE_CODE=

# Web Push do despertador. Gere o par uma vez e nunca troque (trocar invalida as assinaturas):
#   docker compose run --rm api python -m app.core.push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# IA para estudos (Fase 12). Qualquer provedor compatível com a API da OpenAI; sem chave, o app
# mostra "IA não configurada". Gratuitos para começar: Groq, Google AI Studio (Gemini), Mistral.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
